// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  archived  Boolean  @default(false)

  shiftLogs      ShiftLog[]
  calendarEvents CalendarEvent[]
  peakRequests   PeakRequest[]
  user           User?
  qaIssues       QAIssue[]
  qaAgentReports QAAgentReport[]
  telegramReminderLogs TelegramReminderLog[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   // "head" | "lead" | "agent" | "peek_handler"
  team            String  @default("support") // "support" | "peekviewer" — home team, drives default landing space + which team's tabs render
  secondaryTeam   String? // "peekviewer" for Victoria Davis & Sandra Moore only — grants the header team switcher; null for everyone else
  peekviewerAdmin Boolean @default(false) // Sandra Moore, Victoria Davis, Yana Fedorova — elevated actions across every Peekviewer-team feature (Boost queue, Proxy/Row Accounts management, Peekviewer KPI + Updates authoring); not derived from role since Yana is role "agent"
  hiddenPeekviewerTabs String @default("") // comma-separated Peekviewer tab ids (e.g. "schedule") this specific user shouldn't see — per-person exception on top of the team-wide tab set, e.g. Anna Bilous has no Request Schedule
  avatarUrl String?  // data URL of a small uploaded profile photo, e.g. "data:image/jpeg;base64,..." — shown instead of the initial-letter avatar when set
  googleId  String?  @unique
  agentId   String?  @unique
  agent     Agent?   @relation(fields: [agentId], references: [id])
  peekOnDuty       Boolean @default(false) // manually toggled "I'm online" status for Peek Requests duty
  peekDutyEligible Boolean @default(false) // extra non-peek_handler users allowed to toggle peekOnDuty (e.g. an agent who sometimes covers Peek)
  peekCalendarAccess Boolean @default(false) // extra non-peek_handler user allowed to view/edit + be scheduled on the Peek Requests Calendar (e.g. Julia Manson)
  telegramChatId     String?   @unique // set once the user completes the Telegram link flow
  telegramLinkCode   String?   @unique // short-lived pending code shown in the Connect Telegram modal
  telegramLinkExpiry DateTime? // telegramLinkCode becomes invalid after this
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans            Plan[]
  quickLinks       QuickLink[]
  shortcuts        Shortcut[]
  sentMessages     InboxMessage[] @relation("SentMessages")
  receivedMessages InboxMessage[] @relation("ReceivedMessages")
  reviews          ClientReview[]
  pdpPlan          PdpPlan?
  peekCalendarEntries PeekCalendarEntry[]
  personalShortcuts    PersonalShortcut[]
  personalShortcutTags PersonalShortcutTag[]
  authoredUpdates      Update[]     @relation("AuthoredUpdates")
  updateReads          UpdateRead[]
  boostRequests        BoostRequest[]
  authoredOnboardingBlocks OnboardingBlock[]
  accountRequests      AccountRequest[]
  requestScheduleReminderLogs RequestScheduleReminderLog[]
  notes                Note[]

  @@index([peekOnDuty])
  @@index([team])
}

model Update {
  id         String    @id @default(cuid())
  authorId   String?
  author     User?     @relation("AuthoredUpdates", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String    // denormalized (same pattern as Shortcut.createdByName) — survives author account removal
  title      String
  content    String
  tag        String?   // "Important" | "Policy change" | "Reminder" | null
  attachments String   @default("[]") // JSON: [{url, pathname, name, contentType, size}] — Vercel Blob (private store)
  team       String    @default("support") // "support" | "peekviewer" — scopes the broadcast to one team's Inbox
  editedAt   DateTime? // set on edit; null until then — drives the "Edited" indicator
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  reads      UpdateRead[]

  @@index([authorId])
  @@index([team])
}

model UpdateRead {
  id       String    @id @default(cuid())
  updateId String
  update   Update    @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  read     Boolean   @default(false)
  readAt   DateTime?

  @@unique([updateId, userId], name: "updateId_userId")
  @@index([updateId])
  @@index([userId])
}

model Plan {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  completed            Boolean  @default(false)
  type                 String   // "daily" | "monthly"
  date                 String?  // "YYYY-MM-DD" for both daily and monthly
  priority             String   @default("medium") // "high" | "medium" | "low"
  category             String   @default("work")   // "work" | "learning" | "personal"
  dueTime              String?                     // "HH:MM" optional
  carriedOver          Boolean  @default(false)
  carriedOverDismissed Boolean  @default(false)
  reminderSent         Boolean  @default(false) // 24h-before-due Telegram reminder already sent
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([type, date])
  @@index([completed, reminderSent])
}

model InboxMessage {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  type       String   // "task_assignment" | "qa_report" | "salary_message" | "general"
  subject    String?
  content    String
  metadata   String?  // JSON: { year, month, agentId, reportId, status } — only for type "qa_report"
  replyToId  String?  // id of the InboxMessage this one is a reply to (loose reference, no relation)
  read       Boolean  @default(false)
  deletedBySender   Boolean @default(false)
  deletedByReceiver Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([receiverId])
  @@index([senderId])
  @@index([receiverId, read])
}

model ShiftLog {
  id        String    @id @default(cuid())
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id])
  shiftType String
  shiftDate DateTime  // UTC date of shift start
  hoursWorked Float   // 11 for morning, 8 for night

  // Metrics
  chatsCount         Int @default(0)
  ticketsCount       Int @default(0)
  callsCount         Int @default(0)
  refundRequestsCount Int @default(0)

  comments  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archived  Boolean  @default(false)

  @@index([agentId])
  @@index([shiftDate])
}

model CalendarEvent {
  id           String    @id @default(cuid())
  agentId      String
  agent        Agent     @relation(fields: [agentId], references: [id])
  eventDate    DateTime  // UTC
  leaveType    String
  shiftType    String?
  isExtraShift Boolean   @default(false)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archived     Boolean   @default(false)

  @@index([agentId])
  @@index([eventDate])
}

model AIChatQA {
  id        String   @id @default(cuid())
  channel   String
  status    String   @default("OPEN")
  chatText  String
  issueDate DateTime // UTC date of the chat
  comment   String   // what's wrong
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archived  Boolean  @default(false)

  @@index([channel])
  @@index([issueDate])
}

model QAReport {
  id           String          @id @default(cuid())
  year         Int
  month        Int
  totalChats   Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  issues       QAIssue[]
  agentReports QAAgentReport[]

  @@unique([year, month])
}

model QAIssue {
  id        String   @id @default(cuid())
  reportId  String
  report    QAReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  chatRef   String
  issueType String   // "technical" | "communication" | "no_response"
  notes     String?
  comments  String   @default("[]") // JSON: [{id, type: "comment", authorId, authorName, authorRole, text, createdAt}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@index([agentId])
}

model QAAgentReport {
  id             String    @id @default(cuid())
  reportId       String
  report         QAReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id])
  status         String    @default("draft")  // "draft" | "sent" | "returned" | "resent"
  totalChats     Int?
  note           String?
  comments       String    @default("[]") // JSON: [{id, type: "comment"|"status_change", authorId?, authorName?, authorRole?, status?, text, createdAt}] — report-level timeline
  sentByUserId   String?   // who last sent/resent — routes agent replies back to the right person
  inboxMessageId String?   // the InboxMessage shown in the agent's inbox, updated in place on resend
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([reportId, agentId])
  @@index([reportId])
  @@index([agentId])
}

model ClientReview {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  url         String
  clientName  String?
  submittedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archived    Boolean  @default(false)

  @@index([userId])
  @@index([submittedAt])
}

model PdpPlan {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart String?   // "YYYY-MM-DD"
  periodEnd   String?   // "YYYY-MM-DD"
  status      String    @default("in_progress") // "in_progress" | "completed"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goals    PdpGoal[]
  tasks    PdpTask[]
  feedback PdpFeedback?
}

model PdpGoal {
  id              String   @id @default(cuid())
  planId          String
  plan            PdpPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  goal            String
  specificActions String?
  progressPct     Int      @default(0)
  status          String   @default("not_started") // "not_started" | "in_progress" | "done"
  adminRating     Int?     // 1-5, editable by head/lead only
  targetDate      String?  // "YYYY-MM-DD"
  assignedByName  String?  // set when an admin creates this goal on an agent's plan
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks PdpTask[]

  @@index([planId])
}

model PdpTask {
  id             String   @id @default(cuid())
  planId         String
  plan           PdpPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  goalId         String?
  goal           PdpGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  task           String
  completed      Boolean  @default(false)
  status         String   @default("not_started") // "not_started" | "in_progress" | "completed"
  adminGrade     Int?     // 1-5, editable by head/lead only
  comments       String   @default("[]") // JSON: [{authorId, authorName, text, createdAt}]
  assignedByName String?  // set when an admin creates this task on an agent's plan
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([planId])
  @@index([goalId])
}

model PdpFeedback {
  id           String    @id @default(cuid())
  planId       String    @unique
  plan         PdpPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  mentorRating Int?      // 1-5 stars
  mostHelpful  String?
  improvements String?
  achievements String?
  nextFocus    String?
  submittedAt  DateTime? // null until agent submits
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model KpiSettings {
  id        String   @id @default("global")
  data      String   @default("{}")  // JSON blob — one global row for all agents
  updatedAt DateTime @updatedAt
  updatedBy String?  // userId of last admin who saved
}

model QuickLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  url       String
  category  String   @default("")   // "" | "sheets" | "docs" | "tools" | "jira" | "other"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Shortcut {
  id            String   @id @default(cuid())
  title         String
  type          String   @default("text") // "text" | "link"
  content       String   // the URL for "link"; for "text", kept in sync with variants[0] (legacy single-variant fallback)
  variants      String   @default("[]") // JSON: [{id, label, content}] — multiple response variants for "text" shortcuts only
  category      String   @default("") // legacy flat tag — still the only field the Add/Edit form writes to; product/topic are derived from it server-side
  product       String   @default("") // facet: Android | iOS | Geofinder | Glassagram | Знайомства | Premium | "" (derived from category)
  topic         String   @default("") // facet: Billing | General | Sales | Common ticket answers | Common requests | "" (derived from category)
  pinned        Boolean  @default(false) // team-wide pin, toggleable by any authenticated user
  imageData     String?  // full data URL of a pasted/resized image, e.g. "data:image/jpeg;base64,..."
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([product])
  @@index([topic])
  @@index([pinned])
}

// Per-tag metadata (display order, color) for the product/topic facets. Kept
// separate from Shortcut itself — order and color are properties of the tag
// ("Android" displays 2nd and is blue), not of any individual shortcut row, and
// storing them redundantly on every row sharing that tag would mean keeping N
// rows in sync on every reorder/recolor instead of updating one row here.
// Shortcut.product/topic stay plain strings, matching the tag's `name` exactly.
model ShortcutTag {
  id        String   @id @default(cuid())
  kind      String   // "product" | "topic"
  name      String   // matches Shortcut.product or Shortcut.topic exactly
  color     String   // hex, e.g. "#85B7EB"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, name], name: "kind_name")
  @@index([kind, order])
}

// Private, per-agent shortcuts — same shape as Shortcut/ShortcutTag but every
// query is scoped by userId with no admin override at all (confirmed: fully
// private, no exceptions). Kept as separate models rather than a visibility
// flag on Shortcut/ShortcutTag: createdById there is an audit field (nullable,
// SetNull on delete), the opposite of what an access-control boundary needs,
// and a shared table means every future query must remember to filter by
// owner correctly forever. A separate table makes a missing userId filter an
// immediately obvious bug instead of a silent leak. Also has no `category`
// field — there's no team-wide mapping that makes sense for one agent's own
// organization, so product/topic are assigned directly on the form.
model PersonalShortcut {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      String   @default("text") // "text" | "link"
  content   String
  variants  String   @default("[]") // JSON: [{id, label, content}]
  imageData String?
  product   String   @default("")
  topic     String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, product])
  @@index([userId, topic])
  @@index([userId, pinned])
}

model PersonalShortcutTag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // "product" | "topic"
  name      String
  color     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, name], name: "userId_kind_name")
  @@index([userId, kind, order])
}

// One card per unique client (matched by contactEmail + profileNickname).
// Holds the aggregate/current state; individual requests live in PeakRequest,
// linked via clientCardId. The "active" request for a card is simply the one
// with the latest createdAt (see peakRequests.ts) — no separate isActive flag.
model ClientCard {
  id              String    @id @default(cuid())
  contactEmail    String?
  profileNickname String?
  // Null when either identity field is blank, so blank-identity cards never
  // accidentally merge with each other (Postgres/SQLite both treat multiple
  // NULLs as non-conflicting under a unique index). When both are present:
  // normalizeMatchKey(email, nickname) — lowercase+trim both, join with "|".
  // Same helper is used here, in match-or-create, and in the identity-edit
  // collision check in peakRequests.ts — never three separate implementations.
  matchKey        String?   @unique
  status          String    @default("NEW")   // mirrors the active request's status
  starred         Boolean   @default(false)
  archived        Boolean   @default(false)
  doneAt          DateTime? // set when status transitions to DONE; auto-archived 24h after
  lastActivityAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // "I verified this account still works" stamp — settable only by the peek
  // team (peekCalendar.ts's isAssignable predicate), shown on In Progress cards.
  lastCheckedByName String?
  lastCheckedAt     DateTime?

  requests        PeakRequest[]
  resolutionCredits PeekResolutionCredit[]

  @@index([status])
  @@index([status, archived])
}

// One row per Done transition — who resolved it and who gets credit for it
// (may differ: e.g. a regular agent resolves it, credit defers to whoever was
// on duty per the Peek Calendar that day). See peakRequests.ts for the rule.
// No historical backfill — tracks resolutions going forward only.
model PeekResolutionCredit {
  id             String    @id @default(cuid())
  clientCardId   String
  clientCard     ClientCard @relation(fields: [clientCardId], references: [id], onDelete: Cascade)
  movedByUserId  String?
  movedByName    String
  creditedUserId String?
  creditedName   String
  resolvedDate   DateTime  // UTC-midnight day marker, same convention as PeekCalendarEntry.eventDate
  createdAt      DateTime  @default(now())

  @@index([creditedUserId, resolvedDate])
  @@index([resolvedDate])
}

model PeakRequest {
  id            String        @id @default(cuid())
  clientCardId  String
  clientCard    ClientCard    @relation(fields: [clientCardId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Agent         @relation(fields: [agentId], references: [id])
  contactEmail     String?    // legacy per-row copy, kept for data-safety — ClientCard now owns identity
  profileNickname  String?    // legacy per-row copy, kept for data-safety — ClientCard now owns identity
  requestText      String
  status        String        @default("NEW")
  doneAt        DateTime?     // legacy; ClientCard.doneAt is authoritative for auto-archive going forward
  comments      String        @default("[]") // JSON: [{id, authorId, authorName, text, createdAt, editedAt?}]
  tags          String        @default("")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  archived      Boolean       @default(false) // legacy; ClientCard.archived is authoritative going forward

  @@index([agentId])
  @@index([status])
  @@index([status, archived])
  @@index([clientCardId])
  @@index([clientCardId, createdAt])
}

// Dedup log for the shift-reminder cron — the external scheduler that hits
// /api/cron/shift-reminders isn't guaranteed to fire exactly once per window,
// and Vercel serverless functions share no in-memory state between invocations,
// so this table's unique constraint is the only reliable "send exactly once" guard.
model TelegramReminderLog {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  reminderType String   // "MORNING_START" | "MORNING_END" | "NIGHT_START" | "NIGHT_END"
  shiftDate    String   // "YYYY-MM-DD", Kyiv-local calendar day the reminder is about
  sentAt       DateTime @default(now())

  @@unique([agentId, reminderType, shiftDate])
  @@index([agentId])
}

// Who's covering Peek Requests each day — separate from the Support Agents Shift
// Calendar (CalendarEvent) since assignees here are Users directly (Iryna Kolodienko
// and Victoria Horopeka are peek_handlers with no Agent record at all), not Agents,
// and there's no leave-type/shift-type structure, just an optional free-form hours string.
// One row per person (support agent or Peekviewer team member) per calendar
// month. Peekviewer team members largely have no User/Agent record at all
// (e.g. Yana Fedorova) — the roster, formulas and rates live in
// server/src/salaryConfig.ts, keyed by personKey, not in the DB. This table
// only holds what a head/lead has manually overridden or added that month.
model SalaryRecord {
  id        String   @id @default(cuid())
  personKey String   // matches a personKey in salaryConfig.ts, e.g. "jonathan_lewis"
  team      String   // "support" | "peekviewer"
  year      Int
  month     Int      // 1-12
  overrides String   @default("{}") // JSON: { hours?, rate?, reviewsCount?, reviewsBonus?, peekBonus?, trustpilotOn?, updateOn?, uMobixOn?, strukturaOn?, total? }
  bonuses   String   @default("[]") // JSON: [{ id, description, amount }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Salary notification tracking — notifiedMessageId lets a resend update the
  // same InboxMessage in place instead of piling up duplicates, same pattern
  // as QAAgentReport.inboxMessageId.
  notifiedAt        DateTime?
  notifiedMessageId String?

  @@unique([personKey, year, month])
  @@index([year, month])
}

model PeekCalendarEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventDate DateTime // UTC date marker (day-only), same convention as CalendarEvent.eventDate
  hours     String?  // optional free-form working hours, e.g. "09:00-17:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([eventDate])
}

// Peekviewer Team — "Boost" tab. Any team member can request a boost; only
// peekviewerAdmin users (Yana Fedorova, Sandra Moore, Victoria Davis) see the
// full queue and can complete/edit/delete. "archived" isn't a separate flag —
// status: "complete" is what drops a request off the admin worklist, while the
// requester keeps seeing their own request (green) regardless of status.
model BoostRequest {
  id              String    @id @default(cuid())
  requesterId     String
  requester       User      @relation(fields: [requesterId], references: [id])
  requesterName   String
  boostType       String    // "likes" | "followers" | "comments"
  link            String    // post link (likes/comments) or account link (followers)
  quantity        Int
  status          String    @default("in_progress") // "in_progress" | "complete"
  completedAt     DateTime?
  completedByName String?
  batchId         String?   // groups everything submitted together in one /bulk call — the "your batch is fully processed" Telegram notification waits until every row sharing this batchId is complete. Null for rows created before this field existed.
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([batchId])
}

// Peekviewer Team — "Proxy" tab. Shared pool: peekviewerAdmin users bulk-add
// (one row per pasted line), any team member can claim ("Taken by me") and
// copy the value. A taken proxy isn't deleted — it just moves from the
// "Available" list to the "Archive" list (takenById != null), both visible to
// everyone. `header` classifies a whole bulk-add batch (e.g. "Mobile", "USA",
// "Ukraine") — the list groups proxies by this value into named blocks; "" is
// the ungrouped/legacy bucket.
model Proxy {
  id          String    @id @default(cuid())
  value       String
  header      String    @default("")
  addedById   String
  addedByName String
  takenById   String?
  takenByName String?
  takenAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([takenById])
  @@index([header])
}

// Peekviewer Team — "Row Accounts" tab. Same shared-pool/claim shape as Proxy,
// but holds a full credential set. Stored as plain text — internal-only app,
// confirmed acceptable trust model (same as everywhere else in this app).
// `header` groups a bulk-add batch into a named block, same as Proxy.header.
model RowAccount {
  id            String    @id @default(cuid())
  login         String
  password      String
  twoFaCode     String?
  email         String?
  emailPassword String?
  header        String    @default("")
  addedById     String
  addedByName   String
  takenById     String?
  takenByName   String?
  takenAt       DateTime?
  createdAt     DateTime  @default(now())

  @@index([takenById])
  @@index([header])
}

// Peekviewer Team — "Request Schedule" tab. The base day-to-agent assignment
// is a pure rotation formula computed in code (server/src/routes/requestSchedule.ts),
// not stored anywhere — no external spreadsheet dependency. This table only
// holds per-day swaps agents make on top of that formula (drag-and-drop to
// trade days); a date with no row here just uses the formula's answer.
model RequestScheduleOverride {
  id        String   @id @default(cuid())
  date      String   @unique // "YYYY-MM-DD"
  userId    String
  userName  String
  setByName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// Peekviewer Team — "Onboarding" tab (inside My Space). Product info + how-to
// material, authored only by Sandra Moore / Victoria Davis (role head/lead —
// within the Peekviewer team that's exactly those two, no separate flag
// needed), readable by every team member. Attachments reuse the same Vercel
// Blob private-store + presigned-URL pattern as Update.attachments, but are
// rendered inline (img/video) rather than as a download link.
model OnboardingBlock {
  id          String    @id @default(cuid())
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  title       String
  content     String
  attachments String    @default("[]") // JSON: [{url, pathname, name, contentType, size}]
  parentId    String?   // set on a sub-block — the top-level block it's nested under. One level of nesting only: a block that has a parentId may not itself be used as a parent (enforced in onboarding.ts, not here).
  parent      OnboardingBlock?  @relation("OnboardingBlockChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    OnboardingBlock[] @relation("OnboardingBlockChildren")
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorId])
  @@index([parentId])
}

// Peekviewer Team — "New account request" (sent via Inbox's New Message
// form, only offered when the recipient picked is Anna Bilous). Anna is the
// sole recipient/processor — this isn't a generic assignee field — so there's
// no receiverId; the request always resolves to her account server-side.
// Shows up in her References tab as a queue (status + comments), and the
// sender tracks it back in Inbox's "Requests sent to Anna" view. A companion
// InboxMessage (inboxMessageId) is what actually lands in Anna's regular
// Inbox — same "structured record + plain notification message" split as
// QAAgentReport/SalaryRecord already use in this app.
model AccountRequest {
  id             String   @id @default(cuid())
  requesterId    String
  requester      User     @relation(fields: [requesterId], references: [id])
  requesterName  String
  content        String
  status         String   @default("open") // "open" | "in_progress" | "done"
  comments       String   @default("[]")   // JSON: [{id, authorName, text, createdAt}]
  archived       Boolean  @default(false)
  inboxMessageId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
  @@index([archived])
}

// One row per user per Kyiv-local date a "your turn to submit new-profile
// requests" Telegram reminder was actually sent — dedup guard for the
// request-schedule-reminder cron job, same @@unique-then-catch-P2002 pattern
// as TelegramReminderLog (that one is keyed by Agent, but Tetyana/Yana/Anna/
// Iryna/Horopeka aren't all in the Agent table, so this is keyed by User).
model RequestScheduleReminderLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   String   // "YYYY-MM-DD", Kyiv-local calendar day the reminder is about
  sentAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

// My Space — "Notes" tab. Fully personal (private to the owner, both teams,
// no author/admin distinction like Onboarding) — title + free text, own CRUD
// only, no sharing.
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

# PostgreSQL password for the Docker-managed container. Pick something strong.
POSTGRES_PASSWORD=your-strong-password-here

# Must use the same password as above.
DATABASE_URL=postgresql://teamspace:your-strong-password-here@postgres:5432/teamspace

PORT=3001
NODE_ENV=production

# Public URL of the app — no trailing slash. Used for CORS.
# Example: https://teamspace.example.com
CLIENT_URL=https://your-domain.com

# Generate with: openssl rand -base64 32
SESSION_SECRET=generate-with-openssl-rand-base64-32

# From Google Cloud Console (see DEPLOY.md Step 1)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must exactly match the redirect URI registered in Google Cloud Console.
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your-bot-token
# Bot's @username (no @), shown in the Connect Telegram modal's link.
TELEGRAM_BOT_USERNAME=your_bot_username
# Shared secret Telegram echoes back on every webhook call — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also passed as secret_token when running scripts/set-telegram-webhook.ts.
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret

# Shared secret the external scheduler (.github/workflows/shift-reminders.yml)
# sends as the X-Cron-Secret header. Same generation method as above — must
# also be set as a GitHub Actions repo secret of the same name/value.
CRON_SECRET=generate-a-random-secret
